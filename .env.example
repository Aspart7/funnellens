# Firebase Client (Public - safe for browser bundle; enables Google/Email login & Firestore reads)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server-only - used by webhook/workers to write users/{uid}.plan securely)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Trigger.dev v3 (Server-only - authenticates background Playwright/Gemini capture jobs in production)
TRIGGER_SECRET_KEY=

# Gemini Vision API (Server-only - analyzes 1280x800 capture + DOM anchor map)
GEMINI_API_KEY=
# Optional override model name (defaults cleanly to gemini-3.5-flash with fallback chain)
GEMINI_MODEL=gemini-3.5-flash

# Local Headless Chrome path for Playwright live audit (auto-detected on Windows/Linux if omitted)
PLAYWRIGHT_EXECUTABLE_PATH=

# Stripe Test Mode (Sandbox billing keys; never put sk_test/whsec in NEXT_PUBLIC_*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Public origin used for Stripe redirects and shareable audit links
NEXT_PUBLIC_APP_URL=https://funnellens-pied.vercel.app
